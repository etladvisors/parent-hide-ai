<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.family.sg-digest</string>

  <!-- Edit both paths: `which node` for the first, the install dir for the second. -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/CHILD_USERNAME/sg-digest/digest.mjs</string>
  </array>

  <!-- Runs nightly at 21:30; launchd also runs it at next wake if the Mac was asleep. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>21</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/CHILD_USERNAME/sg-digest/digest.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/CHILD_USERNAME/sg-digest/digest.log</string>
</dict>
</plist>
