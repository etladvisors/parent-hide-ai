{
  "manifest_version": 3,
  "name": "Parent Hide AI",
  "version": "3.4.0",
  "description": "Parental search filter: hides Google AI features, blocks image/video/forum/shopping search, and blocks parent-chosen search terms.",
  "minimum_chrome_version": "120",
  "permissions": ["declarativeNetRequest", "webNavigation", "storage", "alarms"],
  "host_permissions": [
    "*://*.google.com/*",
    "*://*.google.co.uk/*",
    "*://*.bing.com/*",
    "*://duckduckgo.com/*",
    "*://*.yahoo.com/*",
    "*://search.brave.com/*",
    "*://*.ecosia.org/*",
    "*://*.youtube.com/*",
    "*://*.pinterest.com/*",
    "*://*.reddit.com/*",
    "*://*.tiktok.com/*",
    "*://*.tumblr.com/*",
    "*://*.instagram.com/*",
    "*://*.myfitnesspal.com/*",
    "*://*.cronometer.com/*",
    "*://*.loseit.com/*",
    "*://*.calorieking.com/*",
    "*://*.fatsecret.com/*",
    "*://*.nutritionix.com/*",
    "*://*.caloriecounter.com/*",
    "*://*.bmi-calculator.net/*",
    "*://*.calculator.net/*",
    "*://*.smartbmicalculator.com/*",
    "*://*.noom.com/*",
    "*://*.weightwatchers.com/*",
    "*://*.ww.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://www.google.com/*", "*://google.com/*"],
      "js": ["hide-ai.js"],
      "css": ["hide.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.google.com/*",
        "*://*.google.co.uk/*",
        "*://*.bing.com/*",
        "*://duckduckgo.com/*",
        "*://*.yahoo.com/*",
        "*://search.brave.com/*",
        "*://*.ecosia.org/*",
        "*://*.youtube.com/*",
        "*://*.pinterest.com/*",
        "*://*.reddit.com/*",
        "*://*.tiktok.com/*",
        "*://*.tumblr.com/*",
        "*://*.instagram.com/*"
      ],
      "js": ["query-guard.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
