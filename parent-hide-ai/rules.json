[
  {
    "id": 1,
    "priority": 1,
    "action": {
      "type": "redirect",
      "redirect": {
        "transform": {
          "queryTransform": {
            "removeParams": ["udm"]
          }
        }
      }
    },
    "condition": {
      "regexFilter": "^https?://(www\\.)?google\\.com/search\\?.*[?&]udm=50",
      "resourceTypes": ["main_frame"]
    }
  },
  {
    "id": 2,
    "priority": 1,
    "action": {
      "type": "redirect",
      "redirect": {
        "regexSubstitution": "https://www.google.com/search?q=\\1"
      }
    },
    "condition": {
      "regexFilter": "^https?://(?:www\\.)?google\\.com/(?:async/)?aimode\\?.*?(?:^|&)q=([^&]*)",
      "resourceTypes": ["main_frame"]
    }
  }
]
